# Used by both docker-compose.yml (dev) and docker-compose.prod.yml.
# Every variable is mandatory — neither file has a fallback value.

# --- Postgres --------------------------------------------------------
POSTGRES_USER=barakasell
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barakasell_lite
DB_PORT=5434

# --- API (apps/api) ----------------------------------------------------
DATABASE_URL="postgresql://barakasell:change-me@db:5432/barakasell_lite?schema=public"
JWT_SECRET=change-me-in-production
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
API_PORT=4000
# TOTP secret for sensitive admin operations (generate with: node -e "const {authenticator}=require('otplib');console.log(authenticator.generateSecret())")
TOTP_SECRET=MFRGGZDFMZTWQ2LK
# Shared secret between the API and apps/bot — the bot has no Prisma
# client and calls /api/bot/* with this in the X-Service-Key header.
SERVICE_API_KEY=change-me-shared-secret-with-bot

# --- Admin (apps/admin) --------------------------------------------------
ADMIN_PORT=3000

# --- POS (apps/pos) — host-side port only, `serve` inside always
# listens on 3000. --------------------------------------------------------
POS_PORT=8080

# --- Bot (apps/bot) ------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:change-me
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# Public HTTPS URL Telegram can reach this container on (reverse proxy in
# front of BOT_PORT) — Telegram calls this + "/telegram/webhook".
BOT_PUBLIC_URL=https://your-domain.example
BOT_PORT=4100

# --- docker-compose.prod.yml only: which pre-built images to pull ------
DOCKER_REGISTRY_NAME=registry.example.com/your-namespace
IMAGE_TAG=latest
