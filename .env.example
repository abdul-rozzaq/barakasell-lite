# Used by both docker-compose.yml (dev) and docker-compose.prod.yml.
# Every variable is mandatory — neither file has a fallback value.

# --- Postgres --------------------------------------------------------
POSTGRES_USER=barakasell
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barakasell_lite
DB_PORT=5434

# --- API (apps/api) ----------------------------------------------------
DATABASE_URL="postgresql://barakasell:change-me@db:5432/barakasell_lite?schema=public"
JWT_SECRET=change-me-in-production
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
API_PORT=4000
# TOTP secret for sensitive admin operations (generate with: node -e "const {authenticator}=require('otplib');console.log(authenticator.generateSecret())")
TOTP_SECRET=MFRGGZDFMZTWQ2LK

# --- Admin (apps/admin) --------------------------------------------------
ADMIN_PORT=3000

# --- POS (apps/pos) — host-side port only, `serve` inside always
# listens on 3000. --------------------------------------------------------
POS_PORT=8080

# --- docker-compose.prod.yml only: which pre-built images to pull ------
DOCKER_REGISTRY_NAME=registry.example.com/your-namespace
IMAGE_TAG=latest
