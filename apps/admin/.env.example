# Baked into the browser bundle at build time (Next.js NEXT_PUBLIC_*
# convention) — changing this after building the Docker image has no
# effect, you must rebuild.
NEXT_PUBLIC_API_URL="https://baraka-api.edvo.uz/api"

# Read at runtime by `next start` / the standalone server.js. Only
# relevant when running outside Docker or overriding the container's
# default port.
PORT=3000
